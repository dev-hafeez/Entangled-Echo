# EntangledEcho Environment Variables

# Operating & Data Modes
DATA_MODE=seed                    # live | seed | mock
NODE_ENV=production

# Supabase (Optional if running fully offline with local atomic storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Token Encryption & Security
TOKEN_ENC_KEY=                    # 32 random bytes, base64 (used for AES-256-GCM token encryption at rest)
INTERNAL_TICK_SECRET=             # Shared secret for /internal/tick
ADMIN_SECRET_KEY=                 # Strong secret for admin panel & privileged endpoints (fails closed if empty)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000 # Comma-separated list of allowed azp origins

# Services
PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_SECRET=

# Meta Graph API (Optional - for live Instagram Business connection)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/graph/callback
META_GRAPH_ACCESS_TOKEN=
META_IG_ACCOUNT_ID=
META_GRAPH_VERSION=v19.0

# LLM Recommendation Provider
LLM_PROVIDER=mock                 # gemini | mock
GEMINI_API_KEY=                   # Official Google Gemini API Key (starts with AIzaSy...)

# Email Provider
EMAIL_PROVIDER=mock               # smtp | mock
SMTP_HOST=127.0.0.1
SMTP_PORT=10255
EMAIL_FROM=notifications@entangled-echo.internal

# Clerk Authentication (Next.js & Express API)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=                        # Optional RSA Public Key (PEM) for local offline JWT signature verification

# Scraper Settings
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_PROFILE_DIR=.chromium-profile
